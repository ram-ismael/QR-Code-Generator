<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="using:QuickQR.ViewModels"
    x:Class="QuickQR.Views.QrGeneratorView"
    x:DataType="vm:QrGeneratorViewModel">

    <Grid ColumnDefinitions="*,250" Margin="24" ColumnSpacing="24">

        <!-- Left: input & options -->
        <StackPanel Grid.Column="0" Spacing="16">

            <TextBlock Text="Generate a QR code from any text or URL." Opacity="0.7" />

            <TextBox Text="{Binding InputText}"
                     PlaceholderText="Type or paste text / a URL..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Error correction" Opacity="0.7" FontSize="12" />
                    <ComboBox ItemsSource="{Binding EccLevels}"
                              SelectedItem="{Binding SelectedEccLevel}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding ModuleSize, StringFormat='Module size: {0:0}px'}" Opacity="0.7" FontSize="12" />
                    <Slider Minimum="4" Maximum="30" Value="{Binding ModuleSize}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !HasError}"
                       Opacity="0.7" />
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"
                       Foreground="IndianRed" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Save as PNG..." Command="{Binding SaveAsPngCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Right: preview -->
         <StackPanel Grid.Column="1" Spacing="16">

            <TextBlock Text="Live preview" Opacity="0.7" />

            <suki:GlassCard CornerRadius="12">
                <Grid Margin="12" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="8"
                            Padding="0"
                            MinHeight="200">
                        <Image Source="{Binding QrImage}"
                            Stretch="Uniform"
                            RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                </Grid>
            </suki:GlassCard>
        </StackPanel>

    </Grid>
</UserControl>
